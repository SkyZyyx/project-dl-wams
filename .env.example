POSTGRES_DB=wams
POSTGRES_USER=wams
POSTGRES_PASSWORD=wams

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,main_service,search_service,nginx

MAIN_DJANGO_SECRET_KEY=dev-main-secret
SEARCH_DJANGO_SECRET_KEY=dev-search-secret

SEARCH_SERVICE_URL=http://search_service:8001
MAIN_SERVICE_URL=http://main_service:8000
QDRANT_URL=http://qdrant:6333

SEARCH_PREPROCESS_ENABLED=1
SEARCH_PREPROCESS_USE_REMBG=0
SEARCH_PREPROCESS_PAD=12
SEARCH_PREPROCESS_THRESHOLD=24
SEARCH_PREPROCESS_MIN_AREA_RATIO=0.01
SEARCH_OOD_COSINE_THRESHOLD=0.35
SEARCH_OOD_TOP_SCORE_THRESHOLD=0.45
SEARCH_COLLECTION_SCROLL_LIMIT=256
