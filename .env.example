POSTGRES_MAIN_DB=postgres_main
POSTGRES_USERS_DB=postgres_users
POSTGRES_PRODUCTS_DB=postgres_products
POSTGRES_ORDERS_DB=postgres_orders
POSTGRES_SEARCH_DB=postgres_search
POSTGRES_USER=wams
POSTGRES_PASSWORD=wams

DJANGO_DEBUG=1
SEARCH_DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,mainservice,searchservice,userservice,productservice,orderservice,nginx

MAIN_DJANGO_SECRET_KEY=dev-main-secret
SEARCH_DJANGO_SECRET_KEY=dev-search-secret
JWT_SIGNING_KEY=dev-shared-jwt-key

SEARCH_SERVICE_URL=http://searchservice:8004
MAIN_SERVICE_URL=http://mainservice:8000
USER_SERVICE_URL=http://userservice:8001
QDRANT_URL=http://qdrant:6333
DEFAULT_SEARCH_MODEL=dinov2_base_triplet_finetuned

SEARCH_PREPROCESS_ENABLED=1
SEARCH_PREPROCESS_USE_REMBG=0
SEARCH_PREPROCESS_PAD=12
SEARCH_PREPROCESS_THRESHOLD=24
SEARCH_PREPROCESS_MIN_AREA_RATIO=0.01
SEARCH_MIN_SCORE_THRESHOLD=0.45
SEARCH_OOD_COSINE_THRESHOLD=-1
SEARCH_OOD_TOP_SCORE_THRESHOLD=0
SEARCH_COLLECTION_SCROLL_LIMIT=256

# Fine-tuned retrieval model mounted by docker-compose from ./model:/model
DINOV2_FINETUNED_CHECKPOINT_PATH=
DINOV2_TRIPLET_FINETUNED_SOURCE=vit_base_patch14_dinov2.lvd142m
DINOV2_TRIPLET_FINETUNED_CHECKPOINT_PATH=/model/retrieval_model.pth
DINOV2_TRIPLET_FINETUNED_VECTOR_SIZE=512
